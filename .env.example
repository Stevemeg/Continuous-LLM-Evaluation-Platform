# Environment-based local configuration — canonical §15, REQ-N-OPS-2.
# Copy to .env. Never commit .env; it is ignored.
#
# There is no default for any credential. A configuration that silently falls
# back to a built-in password is a configuration that ships one.

CLEP_ENV=local

# libpq connection URIs. Fields are user, password, host, port and database.
# Left empty on purpose: the local compose stack uses trust authentication, so
# no local password exists, and every other environment supplies a real one from
# a secrets manager. An example value here would be a credential in a file, and
# the fact that it is "only the local one" is how a real one arrives later.
#
# Migration role owns the schema. The application never uses this.
CLEP_MIGRATION_DSN=

# Runtime role. NOSUPERUSER, NOBYPASSRLS, and does not own the tables
# (ADR-012 D-3). Tenant isolation depends on all three.
CLEP_RUNTIME_DSN=

CLEP_REDIS_URL=redis://localhost:6399

# Provider credentials. Read from the environment, never persisted, never logged
# (REQ-N-SEC-5). Absent values disable the corresponding endpoint rather than
# falling back to another one.
CLEP_PROVIDER_OPENAI_KEY=
CLEP_PROVIDER_OPENAI_BASE=https://api.openai.com/v1
CLEP_PROVIDER_SELF_HOSTED_BASE=http://localhost:8100/v1

# Per-run ceiling applied when a request names no budget of its own.
CLEP_DEFAULT_BUDGET_LIMIT=1.00
CLEP_DEFAULT_BUDGET_CURRENCY=USD
